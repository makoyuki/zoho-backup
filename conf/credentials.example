# /etc/zoho-backup/credentials に置く(root:zbackup 0640)。リポジトリには実際の値を入れない。
# Zoho API Console(https://api-console.zoho.jp/)の Self Client で発行する。発行するユーザーは
# CRM の管理者・Projects の Portal Owner・Books の管理者・Desk の管理者であること。
[oauth]
client_id = 1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
client_secret = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
refresh_token = 1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
